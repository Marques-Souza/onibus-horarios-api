# Configuração local de desenvolvimento. Copie para .env e altere as credenciais.
DB_USER=onibus_user
DB_PASSWORD=onibus_dev_password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_dev_password

# Exemplo fictício para desenvolvimento. Gere uma chave exclusiva com 32 bytes aleatórios.
ADMIN_JWT_SECRET=dGVzdC1zZWNyZXQtdGhhdC1pcy1hdC1sZWFzdC10aGlydHktdHdvLWJ5dGVz

# Reservado para configuração de CORS do front-end.
CORS_ALLOWED_ORIGINS=http://localhost:5173
